# Paperless-ngx configuration. See https://docs.paperless-ngx.com/configuration/
# Redis broker (also read by wait-for-redis.py via PAPERLESS_REDIS)
PAPERLESS_REDIS=redis://redis:6379

# Database (PostgreSQL). Credentials must match the postgres service.
PAPERLESS_DBENGINE=postgresql
PAPERLESS_DBHOST=postgres
PAPERLESS_DBPORT=5432
PAPERLESS_DBNAME=paperless
PAPERLESS_DBUSER=paperless
PAPERLESS_DBPASS=paperless

# Required signing key (placeholder mirrors docker/compose/docker-compose.env).
PAPERLESS_SECRET_KEY=EDenp0yA7P2L5mVcBuXA8UduBWzMznLYu64_i_x5-kXNsaW3_iyBtvnL42nYAx2W2e_Ox8-53UZ01swQu3Puhg
